# ---------------------------------------------------------------------------
# CIAN — variables de entorno
# Copiar a .env.local para desarrollo. En Vercel se configuran en el proyecto.
# Todos los recursos (Postgres, KV, Blob, funciones) viven en la MISMA región.
# Región elegida en Fase 0: iad1 (Washington D.C., EE. UU. Este).
# ---------------------------------------------------------------------------

# --- Base de datos (Vercel Postgres) ---------------------------------------
# Se obtiene al conectar el store de Postgres al proyecto en Vercel.
POSTGRES_URL="postgres://usuario:contrasena@host/basededatos?sslmode=require"

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Generar con: openssl rand -base64 32
AUTH_SECRET=""

# Credenciales de Google OAuth (Google Cloud Console > Credenciales).
# URI de redireccion autorizado:
#   http://localhost:3000/api/auth/callback/google        (desarrollo)
#   https://TU-DOMINIO/api/auth/callback/google           (produccion)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Solo necesario si el despliegue esta detras de un proxy o dominio propio.
# En Vercel se infiere automaticamente.
# AUTH_URL="https://tu-dominio.com"

# --- Modelo de lenguaje (Fase 1) -------------------------------------------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
# CIAN acepta cualquiera de estos nombres; deja solo uno con valor.
GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_API_KEY=""
# GOOGLE_API_KEY=""

# Identificador del modelo. Opcional: si no se define se usa
# gemini-3.1-flash-lite. Existe para poder corregir un nombre de modelo desde
# Vercel sin esperar a un despliegue.
# CIAN_CHAT_MODEL="gemini-3.1-flash-lite"
# CIAN_UTILITY_MODEL="gemini-3.1-flash-lite"

# --- Cron (Fases 6, 8 y 9) --------------------------------------------------
# Vercel firma con este secreto las llamadas del cron. SIN EL, las rutas de
# cron se niegan a correr: dejarlas abiertas permitiria a cualquiera provocar
# el costo de reindexar la biblioteca, disparar notificaciones reales o
# consumir la cuota de la API de Stripe.
# Es el mismo secreto para las tres rutas:
#   /api/cron/reindexar-biblioteca  lunes 8:00 UTC
#   /api/cron/suscripciones         diario 11:00 UTC
#   /api/cron/recordatorios         diario 13:00 UTC
# Generar con: openssl rand -hex 32
CRON_SECRET=""

# --- Cache y limite de uso (Fase 1) ----------------------------------------
# Se obtienen al conectar un store de Redis (Vercel KV / Upstash) al proyecto.
# Son OPCIONALES: sin ellas la aplicacion funciona, pero sin cache de prompts
# y sin limite de mensajes por persona. Ver lib/kv.ts.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# --- Notificaciones push (Fase 8) ------------------------------------------
# Claves VAPID. Se generan UNA vez con: pnpm vapid:generate
# Rotar la clave publica desuscribe a todos los dispositivos, asi que se
# genera una sola vez y no se toca.
# Sin ellas la aplicacion funciona: los recordatorios se registran como
# omitidos y, si hay correo configurado, salen por ahi.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto que exige el RFC 8292. mailto: o https:
VAPID_SUBJECT="mailto:contacto@alianzaindigo.org"

# --- Correo (Fase 8) --------------------------------------------------------
# Se usa para invitar al equipo de apoyo y como respaldo del push.
# Clave de https://resend.com y remitente de un dominio verificado ahi.
# Sin esto la aplicacion no falla: las invitaciones muestran el enlace en
# pantalla para compartirlo a mano.
RESEND_API_KEY=""
EMAIL_FROM="CIAN <avisos@tu-dominio.mx>"

# --- Membresias (Fase 9) ----------------------------------------------------
# Stripe. Sin STRIPE_SECRET_KEY la aplicacion funciona: todo el mundo se queda
# en el plan gratuito, que es un plan completo, y la pantalla lo dice.
STRIPE_SECRET_KEY=""

# Secreto del webhook (Stripe > Developers > Webhooks > el endpoint).
# SIN EL, la ruta /api/stripe/webhook se niega a correr: sin firma, cualquiera
# que conozca la URL podria declarar que pago.
STRIPE_WEBHOOK_SECRET=""

# Identificadores de precio de Stripe, uno por plan y ciclo.
STRIPE_PRICE_PERSONAL_MENSUAL=""
STRIPE_PRICE_PERSONAL_ANUAL=""
STRIPE_PRICE_ORGANIZATION_MENSUAL=""
STRIPE_PRICE_ORGANIZATION_ANUAL=""

# --- Panel de plataforma (Fase 9) -------------------------------------------
# Correos con poder sobre TODO CIAN: prompts, biblioteca curada, limites de
# planes y modelo por omision. Separados por comas.
# Va en variable de entorno y no en la base a proposito: una fila que concede
# este poder es una fila que se puede escribir por accidente.
CIAN_SUPERADMIN_EMAILS="contacto@alianzaindigo.org"

# Modelo de embeddings, si alguna vez cambia. Cambiarlo obliga a reindexar.
# CIAN_EMBEDDING_MODEL="gemini-embedding-001"

# --- Consultorios virtuales (Fase 10) ---------------------------------------
# No hacen falta variables: la videollamada la pone Google Meet y cada
# profesional pega su propio enlace en su perfil dentro de la plataforma.
# CIAN controla quien ve ese enlace y cuando, no lo que ocurre dentro de Meet.
