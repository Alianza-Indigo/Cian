# ---------------------------------------------------------------------------
# CIAN — variables de entorno
# Copiar a .env.local para desarrollo. En Vercel se configuran en el proyecto.
# Todos los recursos (Postgres, KV, Blob, funciones) viven en la MISMA región.
# Región elegida en Fase 0: iad1 (Washington D.C., EE. UU. Este).
# ---------------------------------------------------------------------------

# --- Base de datos (Vercel Postgres) ---------------------------------------
# Se obtiene al conectar el store de Postgres al proyecto en Vercel.
POSTGRES_URL="postgres://usuario:contrasena@host/basededatos?sslmode=require"

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Generar con: openssl rand -base64 32
AUTH_SECRET=""

# Credenciales de Google OAuth (Google Cloud Console > Credenciales).
# URI de redireccion autorizado:
#   http://localhost:3000/api/auth/callback/google        (desarrollo)
#   https://TU-DOMINIO/api/auth/callback/google           (produccion)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Solo necesario si el despliegue esta detras de un proxy o dominio propio.
# En Vercel se infiere automaticamente.
# AUTH_URL="https://tu-dominio.com"

# --- Modelo de lenguaje (Fase 1) -------------------------------------------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
# CIAN acepta cualquiera de estos nombres; deja solo uno con valor.
GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_API_KEY=""
# GOOGLE_API_KEY=""

# Identificador del modelo. Opcional: si no se define se usa
# gemini-3.1-flash-lite. Existe para poder corregir un nombre de modelo desde
# Vercel sin esperar a un despliegue.
# CIAN_CHAT_MODEL="gemini-3.1-flash-lite"
# CIAN_UTILITY_MODEL="gemini-3.1-flash-lite"

# --- Reindexado de la biblioteca (Fase 6) ----------------------------------
# Vercel firma con este secreto las llamadas del cron. SIN EL, la ruta de
# reindexado se niega a correr: dejarla abierta permitiria a cualquiera
# provocar el costo de reindexar la biblioteca entera.
# Generar con: openssl rand -hex 32
CRON_SECRET=""

# --- Cache y limite de uso (Fase 1) ----------------------------------------
# Se obtienen al conectar un store de Redis (Vercel KV / Upstash) al proyecto.
# Son OPCIONALES: sin ellas la aplicacion funciona, pero sin cache de prompts
# y sin limite de mensajes por persona. Ver lib/kv.ts.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# --- Notificaciones push (Fase 8) ------------------------------------------
# Claves VAPID. Se generan UNA vez con: pnpm vapid:generate
# Rotar la clave publica desuscribe a todos los dispositivos, asi que se
# genera una sola vez y no se toca.
# Sin ellas la aplicacion funciona: los recordatorios se registran como
# omitidos y, si hay correo configurado, salen por ahi.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto que exige el RFC 8292. mailto: o https:
VAPID_SUBJECT="mailto:contacto@amecrec.org"

# --- Correo (Fase 8) --------------------------------------------------------
# Se usa para invitar al equipo de apoyo y como respaldo del push.
# Clave de https://resend.com y remitente de un dominio verificado ahi.
# Sin esto la aplicacion no falla: las invitaciones muestran el enlace en
# pantalla para compartirlo a mano.
RESEND_API_KEY=""
EMAIL_FROM="CIAN <avisos@tu-dominio.mx>"
